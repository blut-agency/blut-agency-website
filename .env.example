# Sanity. Copy to .env.local and fill in. Without a project ID the site reads
# src/content/cms-content.json as before.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# The studio (npm run studio) reads these two.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Only for the one-off import (npm run sanity:import). Never commit it.
SANITY_WRITE_TOKEN=
